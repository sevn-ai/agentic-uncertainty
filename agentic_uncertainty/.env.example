# Microsoft Foundry API (for Claude and Grok models via Azure)
FOUNDRY_API_KEY=your-foundry-key-here
FOUNDRY_BASE_URL=https://your-foundry-endpoint.azure.com
# For Grok via Foundry (OpenAI-compatible endpoint)
FOUNDRY_OPENAI_BASE_URL=https://your-foundry-endpoint.azure.com/openai/v1/

# Alternative: Direct Anthropic API (if not using Foundry)
# ANTHROPIC_API_KEY=your-anthropic-key-here

# OpenAI API (for GPT-5.1 Codex)
OPENAI_API_KEY=your-openai-key-here

# Google/Gemini API (for Gemini 3 Pro)
GEMINI_API_KEY=your-gemini-key-here

# Modal (for SWE-bench Pro evaluation)
MODAL_TOKEN_ID=your-modal-token-id
MODAL_TOKEN_SECRET=your-modal-token-secret
MODAL_PROFILE=your-workspace-name